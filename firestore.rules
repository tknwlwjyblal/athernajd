rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'athrnjd@gmail.com' ||
        request.auth.token.email == 'tknwlwjyblal@gmail.com'
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for showcase projects
    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'image', 'district']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.category is string && (
          data.category == 'majlis' ||
          data.category == 'tv-units' ||
          data.category == 'bedrooms' ||
          data.category == 'storage'
        ) &&
        data.image is string && data.image.size() >= 5 && data.image.size() <= 850000 &&
        data.district is string && data.district.size() <= 150 &&
        (!('categoryLabel' in data) || (data.categoryLabel is string && data.categoryLabel.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('featured' in data) || (data.featured is bool)) &&
        (!('span' in data) || (data.span is string && data.span.size() <= 50)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string))) &&
        (!('specs' in data) || (data.specs is map)) &&
        (!('viewsCount' in data) || (data.viewsCount is int && data.viewsCount >= 0));
    }

    // Validation helper for Admin entries
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
        data.email is string && data.email.size() <= 200 &&
        data.role is string && data.role.size() <= 50;
    }

    // Projects / Showcase Collection (Public read, Admin-only write, public view increment)
    match /projects/{projectId} {
      allow get, list: if true;

      allow create: if isValidId(projectId) &&
        isAdmin() &&
        isValidProject(incoming());

      allow update: if isValidId(projectId) && (
        (isAdmin() && isValidProject(incoming())) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) &&
         incoming().viewsCount is int && incoming().viewsCount >= 0)
      );

      allow delete: if isValidId(projectId) && isAdmin();
    }

    // Admins Collection
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminUid) &&
        (isBootstrappedAdmin() || (isAdmin() && isValidAdmin(incoming())));
      allow delete: if isValidId(adminUid) && isBootstrappedAdmin();
    }
  }
}
